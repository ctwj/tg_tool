# Log level: trace, debug, info, warn, error
RUST_LOG=info

# Server port
PORT=3000

# Log directory (optional)
# LOG_DIR=./logs

# Telegram client storage path
TG_STORE=./tg_store

# Telegram API credentials (from https://my.telegram.org)
TG_APP_ID=your_app_id
TG_APP_HASH=your_app_hash

# Database connection string (leave empty for SQLite)
# SQLite: (default, auto-created at ./data.db)
# PostgreSQL: postgres://user:password@localhost:5432/tgtool
SQL_DSN=

# Redis connection string (leave empty for in-memory store)
# redis://localhost:6379
REDIS_CONN_STRING=

# Session secret (required for cookie session persistence across restarts)
SESSION_SECRET=change-me-to-a-random-string

# Optional proxy (e.g. socks5://127.0.0.1:1080)
PROXY_URL=

# Rate limiting per IP
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60
